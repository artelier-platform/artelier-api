#################################
# APPLICATION
#################################

APP_NAME=artelier-api
SERVER_PORT=8080

#################################
# DATABASE (POSTGRESQL)
#################################

DB_HOST=https://your-prod-db-host.example.com
DB_PORT=5432
DB_NAME=artelier_prod
DB_USERNAME=your_prod_db_username
DB_PASSWORD=your_prod_db_password

#################################
# JWT SECURITY
#################################

JWT_SECRET=your_prod_strong_jwt_secret
JWT_KEY_ID=v1-prod-key
JWT_ISSUER=https://api.your-domain.com
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=7

#################################
# CLOUDINARY (MEDIA STORAGE)
#################################

CLOUDINARY_CLOUD_NAME=your_prod_cloud_name
CLOUDINARY_API_KEY=your_prod_api_key
CLOUDINARY_API_SECRET=your_prod_api_secret

#################################
# CORS
#################################

# Comma-separated list of allowed origins (do NOT include trailing slashes)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

#################################
# FLYWAY & JPA
#################################

FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

#################################
# SWAGGER / OPENAPI
#################################

SWAGGER_ENABLED=false

#################################
# SPRING ACTUATOR
#################################

ACTUATOR_EXPOSE=health

#################################
# WOMPI (PAYMENT GATEWAY)
#################################

WOMPI_BASE_URL=https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_prod_xxx
WOMPI_PRIVATE_KEY=priv_prod_xxx
WOMPI_EVENTS_KEY=prod_events_xxx
WOMPI_INTEGRITY_SECRET=prod_integrity_xxx
WOMPI_REDIRECT_URL=https://your-frontend-domain.com/payment/result

#################################
# BREVO (EMAIL SERVICE)
#################################

BREVO_API_KEY=your_prod_brevo_api_key
BREVO_BASE_URL=https://api.brevo.com
BREVO_SENDER_NAME="Artelier Cajica"
BREVO_SENDER_EMAIL=arteliercajica@gmail.com
BREVO_TEMPLATE_AUTH_VERIFICATION=1

#################################
# CAFFEINE (IN-MEMORY CACHE)
#################################

CAFFEINE_MAXIMUM_SIZE=500
CAFFEINE_EXPIRE_AFTER_WRITE=10m

#################################
# REDIS (DISTRIBUTED CACHE)
#################################

SPRING_DATA_REDIS_HOST=https://your-prod-redis-host.example.com
SPRING_DATA_REDIS_PORT=6379
